# Run python scripts/configure_local.py to generate private local secrets.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Keep these private. API billing and processing terms are provider-specific.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Leave blank to use the provider default.
# AI_MODEL=gemini-2.5-flash
# Optional: use a faster, search-capable model from the SAME provider for web research.
# Leave blank to use AI_MODEL. Check model availability with your provider.
AI_WEB_MODEL=
DOCUMENT_MAX_UPLOAD_MB=100
DOCUMENT_MAX_PDF_PAGES=3000
DOCUMENT_MAX_TEXT_CHARS=20000000
DOCUMENT_PROCESSING_TIMEOUT=3600
OCR_ENABLED=1
OCR_LANGUAGE=eng
OCR_DPI=220
OCR_PAGE_TIMEOUT=60
