# Run python scripts/configure_local.py to generate private local secrets.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Manila
# Keep these private. API billing and processing terms are provider-specific.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Leave blank to use the provider default.
# AI_MODEL=gemini-2.5-flash
DOCUMENT_MAX_UPLOAD_MB=100
DOCUMENT_MAX_PDF_PAGES=3000
DOCUMENT_MAX_TEXT_CHARS=20000000
DOCUMENT_PROCESSING_TIMEOUT=3600
OCR_ENABLED=1
OCR_LANGUAGE=eng
OCR_DPI=220
OCR_PAGE_TIMEOUT=60

# Google Cloud > OAuth client > Web application. Both values enable Google login.
# Authorized redirect URI (local): http://localhost:8000/accounts/google/login/callback/
# Add your exact HTTPS callback URI separately when deploying.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# deploy/vercel branch only: configure these in Vercel, never commit real values.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://your-private-s3-endpoint
# AWS_S3_REGION_NAME=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app
